<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.mks.daemon</string>
	<key>Program</key>
	<string>/var/jb/usr/libexec/mksd</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/mobile/mksd.out</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/mksd.err</string>
	<key>UserName</key>
	<string>root</string>
</dict>
</plist>
